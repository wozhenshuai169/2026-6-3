{
  "version": 2,
  "name": "Real provider product-path validation",
  "description": "Validates a deployed main backend through authenticated /api routes. Audio cases require real spoken recordings and never use filename-based Mock matching.",
  "baseUrl": "http://127.0.0.1:8000",
  "thresholds": {
    "minAsrConfidence": 0.6,
    "minVisionConfidence": 0.55
  },
  "testGroups": {
    "text": [
      {
        "id": "real_text_buddha_opening",
        "question": "灵山大佛什么时候落成开光？",
        "expected": {
          "decision": "interrupt_and_answer",
          "requiresCitation": true
        }
      }
    ],
    "image": [
      {
        "id": "real_img_bell_tower",
        "asset": "test_data/full_path_web/images/bell_tower_web.jpg",
        "expected": {
          "recognizedObjectAnyOf": ["钟楼", "鼓楼", "城楼", "古建筑", "bell tower", "Bell Tower"],
          "requiresCitation": false
        }
      },
      {
        "id": "real_img_drum_tower",
        "asset": "test_data/full_path_web/images/drum_tower_web.jpg",
        "expected": {
          "recognizedObjectAnyOf": ["钟楼", "鼓楼", "城楼", "古建筑", "bell tower", "drum tower", "Drum Tower"],
          "requiresCitation": false
        }
      },
      {
        "id": "real_img_main_hall",
        "asset": "test_data/full_path_web/images/main_hall_web.jpg",
        "expected": {
          "recognizedObjectAnyOf": ["主展厅", "大成殿", "hall", "Hall"],
          "requiresCitation": false
        }
      }
    ],
    "voice": [
      {
        "id": "real_voice_private_toilet",
        "recordingText": "我想去厕所",
        "asset": "test_data/real_model_validation/audio/toilet_sentence.wav",
        "channel": "public",
        "expected": {
          "asrContainsAnyOf": ["厕所", "洗手间"],
          "decision": "private_reply",
          "ttsSuccess": true
        }
      },
      {
        "id": "real_voice_lost_emergency",
        "recordingText": "我找不到队伍了",
        "asset": "test_data/real_model_validation/audio/lost_sentence.wav",
        "channel": "private",
        "expected": {
          "asrContainsAnyOf": ["找不到队伍", "走失", "迷路"],
          "decision": "emergency_alert",
          "ttsSuccess": true
        }
      },
      {
        "id": "real_voice_route_short",
        "recordingText": "我想换一条少走路的路线",
        "asset": "test_data/real_model_validation/audio/route_short_sentence.wav",
        "channel": "private",
        "expected": {
          "asrContainsAnyOf": ["少走路", "路线"],
          "decision": "private_reply",
          "ttsSuccess": true
        }
      }
    ],
    "tts": [
      {
        "id": "real_tts_answer",
        "text": "前方右侧就是游客服务中心，那里可以咨询、休息，也可以借用轮椅。",
        "expected": {
          "audioUrlRequired": true
        }
      }
    ]
  }
}
