{
  "version": 2,
  "name": "Real model validation cases",
  "description": "Content-driven validation for real ASR/TTS/vision providers through the main backend /api endpoints.",
  "baseUrl": "http://127.0.0.1:8000",
  "env": {
    "requiredFlag": "RUN_REAL_PROVIDER_TESTS=1",
    "sharedDashScopeKey": "DASHSCOPE_API_KEY",
    "audioPublicUrl": "REAL_MODEL_AUDIO_URL",
    "optionalAsrExpectedText": "REAL_MODEL_ASR_EXPECTED"
  },
  "thresholds": {
    "minAsrConfidence": 0.6,
    "minVisionConfidence": 0.55,
    "minRagCitationHitRate": 0.75
  },
  "testGroups": {
    "audio": [
      {
        "id": "real_audio_asr",
        "endpoint": "/api/audio/asr",
        "method": "POST",
        "request": {
          "roomId": "<created by test>",
          "userId": "<created by test>",
          "channel": "public",
          "audioUrl": "${REAL_MODEL_AUDIO_URL}",
          "audioFormat": "${REAL_MODEL_AUDIO_FORMAT:-wav}"
        },
        "expected": {
          "providerMustNotContain": "mock",
          "trace.isMock": false,
          "textContains": "${REAL_MODEL_ASR_EXPECTED:-}"
        }
      },
      {
        "id": "real_audio_tts",
        "endpoint": "/api/audio/tts",
        "method": "POST",
        "request": {
          "text": "前方右侧是游客服务中心。",
          "voice": "guide_female",
          "audioFormat": "mp3"
        },
        "expected": {
          "providerMustNotContain": "mock",
          "trace.isMock": false,
          "audioUrlRequired": true
        }
      }
    ],
    "vision": [
      {
        "id": "real_vision_bell_tower",
        "asset": "test_data/full_path_web/images/bell_tower_web.jpg",
        "endpoint": "/api/vision/recognize",
        "method": "POST",
        "request": {
          "roomId": "<created by test>",
          "userId": "<created by test>",
          "imageUrl": "<data URI encoded by test>"
        },
        "expected": {
          "providerMustNotContain": "mock",
          "trace.isMock": false,
          "minConfidence": 0.55
        }
      }
    ],
    "voice": [
      {
        "id": "real_public_voice_question",
        "endpoint": "/api/ai/public-voice-question",
        "method": "POST",
        "request": {
          "roomId": "<created by test>",
          "userId": "<created by test>",
          "channel": "public",
          "audioUrl": "${REAL_MODEL_AUDIO_URL}",
          "audioFormat": "${REAL_MODEL_AUDIO_FORMAT:-wav}"
        },
        "expected": {
          "trace.asr.isMock": false,
          "trace.asr.providerMustNotContain": "mock"
        }
      }
    ],
    "rag": [
      {
        "id": "rag_citation_hit_rate",
        "target": "algorithm_service.services.scenic_rag.answer",
        "expected": {
          "minCitationHitRate": 0.75
        }
      },
      {
        "id": "rag_unsupported_refusal",
        "target": "algorithm_service.services.scenic_rag.answer",
        "expected": {
          "sources": [],
          "refused": true
        }
      },
      {
        "id": "rag_synonym_question",
        "target": "algorithm_service.services.scenic_rag.answer",
        "expected": {
          "requiredChunkId": "chunk_015"
        }
      },
      {
        "id": "rag_multi_chunk_synthesis",
        "target": "algorithm_service.services.scenic_rag.answer",
        "expected": {
          "requiredChunkIdsAnyOrder": ["chunk_021", "chunk_008|chunk_009"]
        }
      }
    ]
  }
}
