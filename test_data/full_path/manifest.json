  "testGroups": {
    "text": [
      {
        "id": "text_public_rag_main_hall",
        "endpoint": "/v1/orchestrate",
        "request": {
          "channel": "public",
          "text": "主展厅是什么时候建的？"
        },
        "expected": {
          "expectedDecision": "interrupt_and_answer",
          "expectedCitation": "chunk_001"
        }
      },
      {
        "id": "text_private_facility",
        "endpoint": "/v1/orchestrate",
        "request": {
          "channel": "public",
          "text": "厕所在哪里？"
        },
        "expected": {
          "expectedDecision": "private_reply"
        }
      },
      {
        "id": "text_unknown_rag",
        "endpoint": "/v1/orchestrate",
        "request": {
          "channel": "public",
          "text": "这里有没有恐龙化石？"
        },
        "expected": {
          "expectedDecision": "public_reply",
          "expectedNoFabrication": true
        }
      }
