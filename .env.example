# Runtime
LOG_LEVEL=INFO
DATABASE_PATH=data/app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_SECONDS=86400
GUEST_TTL_SECONDS=43200
WS_TICKET_TTL_SECONDS=60
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=26214400
MAX_AUDIO_UPLOAD_BYTES=12582912
MAX_VISION_BYTES=10485760

# Bootstrap administrator. Set a strong password before the first start.
ADMIN_USER_NAME=admin
ADMIN_PASSWORD=change-this-password

# Optional providers. Empty keys enable an explicitly marked mock fallback.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
MAP_API_KEY=
MAP_PROVIDER=amap

# Feature switches
ENABLE_ASR=true
ENABLE_TTS=true
ENABLE_VISION=true
ENABLE_RAG=true
